APP_ENV=production
SECRET_KEY=            # long random string: python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_EMAIL=           # creates/promotes this admin on start
ADMIN_PASSWORD=        # 10+ characters
SITE_URL=https://yourdomain.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DATABASE_PATH=/var/data/site.db
PROTECTED_DIR=/var/data/protected
# Email notifications for inquiries (optional; Gmail: smtp.gmail.com + an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
